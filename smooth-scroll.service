[Unit]
Description=Smooth wheel scrolling for Linux guests in UTM (SPICE)
After=systemd-udev-settle.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/smooth-scroll.py
# settings from the "Smooth Scrolling" window (override the values below, picked up live);
# install.sh replaces @CONFIG@ with ~/.config/smooth-scroll/config.json of the installing user
Environment=SMOOTH_CONFIG=@CONFIG@
# step per click when moving slowly (fraction of a wheel click)
Environment=SMOOTH_SCALE=0.08
# step grows with the click rate: step × (rate/RATE0)^ACCEL, at most MAXGAIN; ACCEL=0 disables it
Environment=SMOOTH_ACCEL=0.8
Environment=SMOOTH_RATE0=6
Environment=SMOOTH_MAXGAIN=2
# seconds of sustained fast rate before acceleration takes full effect
Environment=SMOOTH_RAMP=0.3
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
